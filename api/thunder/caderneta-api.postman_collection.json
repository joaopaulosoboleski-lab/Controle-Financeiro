{
  "info": {
    "name": "Caderneta API",
    "description": "Pedidos de teste da API em api/. Use com o ambiente 'Caderneta API (local)', que define baseUrl. A API está SEM autenticação por enquanto. As pastas 1 e 2 nunca gravam; a 3 grava em dados reais.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Saúde",
      "item": [
        {
          "name": "Health (público) → 200",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "header": [],
            "description": "Esperado: 200. Não precisa de token. Diz só que o serviço está de pé."
          }
        }
      ]
    },
