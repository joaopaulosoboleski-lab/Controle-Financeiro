    {
      "name": "3. Gravação (DADOS REAIS)",
      "item": [
        {
          "name": "Criar lançamento → 201",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/lancamentos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "lancamentos"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "description": "Esperado: 201. ATENÇÃO: grava no Supabase de produção. Ajuste usuario_id, conta_id e categoria_id (categoria de SAÍDA do mesmo usuário). Anote o lancamento_id e apague o teste depois. 400 com 'Conta inválida'/'Categoria inválida' = ids errados; 500 de permissão = SUPABASE_KEY não é a secret.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usuario_id\": 1,\n  \"conta_id\": 1,\n  \"categoria_id\": 1,\n  \"tipo\": \"saida\",\n  \"valor\": 12.34,\n  \"data_lancamento\": \"2026-11-26\",\n  \"descricao\": \"TESTE API - apagar\"\n}",
