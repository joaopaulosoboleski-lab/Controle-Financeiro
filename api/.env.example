# Copie para api/.env e preencha. Nunca faça commit do .env.

# Project Settings > API > Project URL
SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Project Settings > API: a chave service_role (ou "secret"). A anon NÃO grava:
# o supabase.sql liga RLS sem políticas e revoga anon/authenticated.
# Ela ignora o RLS: use só neste servidor, nunca no app nem no navegador.
SUPABASE_KEY=

# Token que os clientes mandam em "Authorization: Bearer <token>" (mínimo 32 caracteres).
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_TOKEN=

# Opcional (padrão 3000). O Next também usa a 3000 no dev: troque se os dois rodarem juntos.
PORT=3000
