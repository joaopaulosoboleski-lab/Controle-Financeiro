# Copie para api/.env e preencha. Nunca faça commit do .env.

# Project Settings > API > Project URL
SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Project Settings > API Keys: a chave secret (sb_secret_...) ou a antiga service_role.
# A publishable/anon NÃO grava: o supabase.sql liga RLS sem políticas e revoga anon/authenticated.
# Ela ignora o RLS: use só neste servidor, nunca no app nem no navegador.
SUPABASE_KEY=

# Opcional (padrão 3000). O Next também usa a 3000 no dev: troque se os dois rodarem juntos.
PORT=3000
