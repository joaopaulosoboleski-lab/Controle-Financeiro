# Copie para .env.local (desenvolvimento) ou .env.production.local (producao).

# Local:     postgresql://postgres@127.0.0.1:5433/caderneta
# Supabase:  string do "Transaction pooler" (Project Settings > Database), com a senha do banco.
#            Exige o certificado em certs/supabase-ca.crt (SSL Configuration > Download certificate).
DATABASE_URL=

# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Use um valor DIFERENTE em cada ambiente (minimo 32 caracteres em producao).
SESSION_SECRET=
